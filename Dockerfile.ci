FROM ubuntu:26.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    clang-21 \
    clang-format-21 \
    clang-tidy-21 \
    gcc-16 \
    g++-16 \
    cmake \
    ninja-build \
    ccache \
    scons \
    python3 \
    valgrind \
    git \
    ca-certificates \
    libc6-dbg \
    libxrandr-dev \
    libxinerama-dev \
    libxcursor-dev \
    libxi-dev \
    libgl-dev \
    && rm -rf /var/lib/apt/lists/*

RUN ln -s /usr/bin/clang-21 /usr/local/bin/clang && \
    ln -s /usr/bin/clang++-21 /usr/local/bin/clang++ && \
    ln -s /usr/bin/clang-format-21 /usr/local/bin/clang-format && \
    ln -s /usr/bin/clang-tidy-21 /usr/local/bin/clang-tidy

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

RUN uv venv /opt/conan-venv && \
    uv pip install --python /opt/conan-venv/bin/python "conan>=2.34.0"

ENV PATH="/opt/conan-venv/bin:${PATH}"

WORKDIR /workspace
