CompileFlags:
  CompilationDatabase: build
  Add:
    - -std=c++23

Diagnostics:
  UnusedIncludes: None

---

If:
  PathMatch: .*dependencies/godot-cpp/.*
Index:
  Background: Skip

---

If:
  PathMatch: .*src/godot/extension/.*
CompileFlags:
  Add:
    - -I/home/enzo/Documentos/Programming/Karkinos/Karkino/dependencies/godot-cpp/include
    - -I/home/enzo/Documentos/Programming/Karkinos/Karkino/build/godot-cpp/gen/include
    - -I/home/enzo/Documentos/Programming/Karkinos/Karkino/src