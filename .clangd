CompileFlags:
  CompilationDatabase: cmake-build-debug
  Add:
    - -std=c++23

Diagnostics:
  UnusedIncludes: None

---
# Não indexar nada do godot-cpp em background — evita varrer milhares de arquivos
If:
  PathMatch: .*src/godot/godot-cpp/.*
Index:
  Background: Skip

---
# Injetar os includes do godot-cpp nos arquivos da extensão
If:
  PathMatch: .*src/godot/extension/.*
CompileFlags:
  Add:
    - -I/home/enzo/Documentos/Programming/Karkinos/Karkino/src/godot/godot-cpp/include
    - -I/home/enzo/Documentos/Programming/Karkinos/Karkino/src/godot/godot-cpp/gen/include
    - -I/home/enzo/Documentos/Programming/Karkinos/Karkino/src