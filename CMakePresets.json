{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja"
    },
    {
      "name": "conan-debug",
      "hidden": true,
      "toolchainFile": "${sourceDir}/build/Debug/generators/conan_toolchain.cmake"
    },
    {
      "name": "conan-release",
      "hidden": true,
      "toolchainFile": "${sourceDir}/build/Release/generators/conan_toolchain.cmake"
    },
    {
      "name": "clang",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang-21",
        "CMAKE_CXX_COMPILER": "clang++-21",
        "CMAKE_CXX_FLAGS": "-stdlib=libstdc++ --gcc-toolchain=/usr"
      }
    },
    {
      "name": "ccache",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_C_COMPILER_LAUNCHER": "ccache",
        "CMAKE_CXX_COMPILER_LAUNCHER": "ccache"
      }
    },
    {
      "name": "sanitizer-address",
      "hidden": true,
      "cacheVariables": {
        "SANITIZER": "address"
      }
    },
    {
      "name": "sanitizer-thread",
      "hidden": true,
      "cacheVariables": {
        "SANITIZER": "thread"
      }
    },
    {
      "name": "ci-base",
      "hidden": true,
      "inherits": [
        "base",
        "clang",
        "ccache",
        "conan-debug"
      ],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "inherits": [
        "base",
        "clang",
        "conan-debug"
      ],
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "inherits": [
        "base",
        "clang",
        "conan-release"
      ],
      "binaryDir": "${sourceDir}/build-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "KARKINOLUTION_BUILD_VIEW": true
      }
    },
    {
      "name": "native",
      "displayName": "Release, native CPU (benchmarking only, not portable)",
      "inherits": [
        "base",
        "clang",
        "conan-release"
      ],
      "binaryDir": "${sourceDir}/build-native",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_FLAGS": "-march=native",
        "KARKINOLUTION_BUILD_VIEW": true
      }
    },
    {
      "name": "sanitizers",
      "displayName": "Debug with AddressSanitizer and UBSan",
      "inherits": [
        "base",
        "clang",
        "sanitizer-address",
        "conan-debug"
      ],
      "binaryDir": "${sourceDir}/build-sanitizers",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "tsan",
      "displayName": "Debug with ThreadSanitizer",
      "inherits": [
        "base",
        "clang",
        "sanitizer-thread",
        "conan-debug"
      ],
      "binaryDir": "${sourceDir}/build-tsan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "ci-tidy",
      "displayName": "CI: Debug build used by clang-tidy",
      "inherits": "ci-base",
      "binaryDir": "${sourceDir}/build-tidy",
      "cacheVariables": {
        "KARKINOLUTION_BUILD_VIEW": true
      }
    },
    {
      "name": "ci",
      "displayName": "CI: Debug build for unit tests",
      "inherits": "ci-base",
      "binaryDir": "${sourceDir}/build-ci"
    },
    {
      "name": "ci-sanitizers",
      "displayName": "CI: Debug with AddressSanitizer and UBSan",
      "inherits": [
        "ci-base",
        "sanitizer-address"
      ],
      "binaryDir": "${sourceDir}/build-ci-sanitizers"
    },
    {
      "name": "ci-tsan",
      "displayName": "CI: Debug with ThreadSanitizer",
      "inherits": [
        "ci-base",
        "sanitizer-thread"
      ],
      "binaryDir": "${sourceDir}/build-ci-tsan"
    },
    {
      "name": "view-debug",
      "displayName": "Debug with View (raylib)",
      "inherits": [
        "base",
        "clang",
        "conan-debug"
      ],
      "binaryDir": "${sourceDir}/build-view",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "KARKINOLUTION_BUILD_VIEW": true
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release",
      "targets": [
        "karkinolution_app",
        "karkinolution_view"
      ]
    },
    {
      "name": "native",
      "configurePreset": "native",
      "targets": [
        "karkinolution_app",
        "karkinolution_view"
      ]
    },
    {
      "name": "sanitizers",
      "configurePreset": "sanitizers"
    },
    {
      "name": "tsan",
      "configurePreset": "tsan"
    },
    {
      "name": "ci-tidy",
      "configurePreset": "ci-tidy",
      "targets": [
        "karkinolution_app",
        "karkinolution_view"
      ]
    },
    {
      "name": "ci",
      "configurePreset": "ci",
      "targets": [
        "karkinolution_tests",
        "opsiamethystos_tests",
        "karkinolution_app"
      ]
    },
    {
      "name": "ci-sanitizers",
      "configurePreset": "ci-sanitizers",
      "targets": [
        "karkinolution_tests",
        "opsiamethystos_tests",
        "karkinolution_app"
      ]
    },
    {
      "name": "ci-tsan",
      "configurePreset": "ci-tsan",
      "targets": [
        "karkinolution_tests",
        "opsiamethystos_tests",
        "karkinolution_app"
      ]
    },
    {
      "name": "view-debug",
      "configurePreset": "view-debug",
      "targets": [
        "karkinolution_view"
      ]
    },
    {
      "name": "shared-debug",
      "displayName": "shared: Debug build of karkinolution_shared",
      "configurePreset": "debug",
      "targets": [
        "karkinolution_shared"
      ]
    },
    {
      "name": "shared-sanitizers",
      "displayName": "shared: Debug with AddressSanitizer and UBSan",
      "configurePreset": "sanitizers",
      "targets": [
        "karkinolution_shared"
      ]
    },
    {
      "name": "shared-tsan",
      "displayName": "shared: Debug with ThreadSanitizer",
      "configurePreset": "tsan",
      "targets": [
        "karkinolution_shared"
      ]
    },
    {
      "name": "shared-ci",
      "displayName": "shared: CI Debug build",
      "configurePreset": "ci",
      "targets": [
        "karkinolution_shared"
      ]
    },
    {
      "name": "shared-ci-sanitizers",
      "displayName": "shared: CI Debug with AddressSanitizer and UBSan",
      "configurePreset": "ci-sanitizers",
      "targets": [
        "karkinolution_shared"
      ]
    },
    {
      "name": "shared-ci-tsan",
      "displayName": "shared: CI Debug with ThreadSanitizer",
      "configurePreset": "ci-tsan",
      "targets": [
        "karkinolution_shared"
      ]
    },
    {
      "name": "opsiamethystos-debug",
      "displayName": "opsiamethystos: Debug build of opsiamethystos",
      "configurePreset": "debug",
      "targets": [
        "opsiamethystos",
        "opsiamethystos_tests"
      ]
    },
    {
      "name": "opsiamethystos-sanitizers",
      "displayName": "opsiamethystos: Debug with AddressSanitizer and UBSan",
      "configurePreset": "sanitizers",
      "targets": [
        "opsiamethystos",
        "opsiamethystos_tests"
      ]
    },
    {
      "name": "opsiamethystos-tsan",
      "displayName": "opsiamethystos: Debug with ThreadSanitizer",
      "configurePreset": "tsan",
      "targets": [
        "opsiamethystos",
        "opsiamethystos_tests"
      ]
    },
    {
      "name": "opsiamethystos-ci",
      "displayName": "opsiamethystos: CI Debug build",
      "configurePreset": "ci",
      "targets": [
        "opsiamethystos",
        "opsiamethystos_tests"
      ]
    },
    {
      "name": "opsiamethystos-ci-sanitizers",
      "displayName": "opsiamethystos: CI Debug with AddressSanitizer and UBSan",
      "configurePreset": "ci-sanitizers",
      "targets": [
        "opsiamethystos",
        "opsiamethystos_tests"
      ]
    },
    {
      "name": "opsiamethystos-ci-tsan",
      "displayName": "opsiamethystos: CI Debug with ThreadSanitizer",
      "configurePreset": "ci-tsan",
      "targets": [
        "opsiamethystos",
        "opsiamethystos_tests"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "test-base",
      "hidden": true,
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "sanitizer-environment",
      "hidden": true,
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=1:abort_on_error=1",
        "UBSAN_OPTIONS": "halt_on_error=1:print_stacktrace=1"
      }
    },
    {
      "name": "tsan-environment",
      "hidden": true,
      "environment": {
        "TSAN_OPTIONS": "halt_on_error=1:second_deadlock_stack=1"
      }
    },
    {
      "name": "debug",
      "inherits": "test-base",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "inherits": "test-base",
      "configurePreset": "release"
    },
    {
      "name": "sanitizers",
      "inherits": [
        "test-base",
        "sanitizer-environment"
      ],
      "configurePreset": "sanitizers"
    },
    {
      "name": "tsan",
      "inherits": [
        "test-base",
        "tsan-environment"
      ],
      "configurePreset": "tsan"
    },
    {
      "name": "ci",
      "inherits": "test-base",
      "configurePreset": "ci"
    },
    {
      "name": "ci-sanitizers",
      "inherits": [
        "test-base",
        "sanitizer-environment"
      ],
      "configurePreset": "ci-sanitizers"
    },
    {
      "name": "ci-tsan",
      "inherits": [
        "test-base",
        "tsan-environment"
      ],
      "configurePreset": "ci-tsan"
    }
  ]
}